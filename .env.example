# Completar solo en .env.local con el proyecto independiente. Nunca usar claves secretas.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLIENT_LOGIN_ENABLED=0
# Enable only after validating both provider contracts and an authorized client-login deployment.
# VITE_SUPABASE_ANON_KEY se admite solo como compatibilidad con una clave JWT anon.
