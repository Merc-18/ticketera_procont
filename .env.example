# Completar solo en .env.local con el proyecto independiente. Nunca usar claves secretas.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLIENT_LOGIN_ENABLED=0
# Enable for verified providers after running client-login locally or an authorized deployment.
# DEV only: run the existing client-login handler locally; RPCs keep VITE_SUPABASE_URL.
# VITE_CLIENT_LOGIN_DEV_ORIGIN=http://localhost:8000
# VITE_SUPABASE_ANON_KEY se admite solo como compatibilidad con una clave JWT anon.
