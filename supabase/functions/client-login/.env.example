# Server-only Edge configuration. Never copy into VITE_* or commit filled values.
# No defaults: without an explicit URL AND contract per provider, login fails closed.
PROCONT_ALLOWED_ORIGINS=http://localhost:5173
# Production provider endpoints (HTTPS) and their reviewed response contracts (JSON).
QUIPU_AUTH_URL=
QUIPU_AUTH_RESPONSE_CONTRACT=
QUIPUFAC_AUTH_URL=
QUIPUFAC_AUTH_RESPONSE_CONTRACT=
# Local development only (never in hosted environments): enables the development APIs with
# *_AUTH_RESPONSE_CONTRACT=development and the exact development URLs.
# CLIENT_LOGIN_ALLOW_DEVELOPMENT_PROVIDERS=1
# Independent random server-to-server secrets, at least 32 characters each.
QUIPU_PLATFORM_ENTRY_SECRET=
QUIPUFAC_PLATFORM_ENTRY_SECRET=
